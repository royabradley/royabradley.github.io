---
// rab: Series contents for a speaking item. Same markup and classes as the theme's
// src/components/blog/SeriesNav.astro, which only links blog posts and work entries.
import { itemHref, seriesHref, type Item, type Series } from '../../speaking/utils';

interface Props {
  item: Item;
  series: Series;
  items: Item[]; // the series' items in order
}
const { item, series, items } = Astro.props;
const n = items.findIndex((i) => i.id === item.id) + 1;
---

<nav data-pagefind-ignore aria-label="Series" class="border-border mt-10 border-l-2 pl-5 font-sans text-sm">
  <p class="section-label">Series</p>
  <p class="mt-1 font-serif text-lg">
    <a href={seriesHref(series)} class="text-foreground hover:text-primary no-underline">{series.data.title}</a>
  </p>
  <p class="text-muted">Part {n} of {items.length}</p>
  <ol class="mt-3 list-decimal space-y-1 pl-5">
    {items.map((i) => (
      <li>
        {i.id === item.id ? (
          <span aria-current="page" class="text-primary">{i.data.title}</span>
        ) : (
          <a href={itemHref(i)} class="text-muted hover:text-foreground no-underline">{i.data.title}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
