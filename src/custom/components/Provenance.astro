---
// rab: One quiet line under a post's description saying where the piece first came from:
//   Written for CH504: Church History 2, Dr. Joshua Bruce, Knox Theological Seminary · Published as written.
// Renders nothing for posts without provenance fields. Fields: src/custom/utils/provenance.ts.
// Seam: one import and one line in src/layouts/PostLayout.astro.
import type { Post } from '../../utils/posts';
import { formatDate } from '../../utils/posts';
import { REVISION_LABELS } from '../utils/provenance';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { course, instructor, institution, written, revision, pubDate } = post.data;

const source = [course, instructor, institution].filter(Boolean).join(', ');
const sameDay = written && written.toISOString().slice(0, 10) === pubDate.toISOString().slice(0, 10);
const parts = [
  source && `Written for ${source}`,
  written && !sameDay && `written ${formatDate(written, Astro.currentLocale)}`,
  revision && REVISION_LABELS[revision],
].filter(Boolean);
---

{parts.length > 0 && <p class="provenance text-muted mt-4 font-sans text-sm italic">{parts.join(' · ')}.</p>}
