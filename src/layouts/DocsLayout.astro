---
// pro-only. Docs layout. Contents on the left on wide screens, above the text on narrow ones.
import BaseLayout from './BaseLayout.astro';
import CopyCode from '../components/mdx/CopyCode.astro';
import { useT } from '../i18n/t';
import { docHref as href, type Doc } from '../utils/docs';

const t = useT(Astro.currentLocale);

interface Props {
  doc: Doc;
  docs: Doc[]; // result of getDocs()
}
const { doc, docs } = Astro.props;
const i = docs.findIndex((d) => d.id === doc.id);
const prev = docs[i - 1];
const next = docs[i + 1];
---

<BaseLayout title={doc.data.title} description={doc.data.description}>
  <div class="mx-auto grid max-w-5xl grid-cols-[minmax(0,1fr)] gap-10 px-4 py-12 sm:py-16 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-16">
    <nav aria-label={t.docsNav} class="font-sans text-sm">
      <p class="section-label">{t.docs}</p>
      <ul class="border-border mt-4 flex flex-wrap gap-x-5 gap-y-2 border-b pb-6 lg:sticky lg:top-8 lg:flex-col lg:border-b-0 lg:pb-0">
        {docs.map((d) => (
          <li>
            <a
              href={href(d)}
              aria-current={d.id === doc.id ? 'page' : undefined}
              class="text-muted hover:text-foreground aria-[current=page]:text-primary no-underline"
            >
              {d.data.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <article data-pagefind-body class="max-w-prose">
      <h1 class="text-5xl font-light tracking-tight">{doc.data.title}</h1>
      <p class="text-muted mt-4 text-xl">{doc.data.description}</p>
      <div class="prose mt-10">
        <slot />
      </div>
      <CopyCode />
      {(prev || next) && (
        <nav
          aria-label={t.pagination}
          class="border-border mt-16 grid gap-4 border-t pt-8 font-sans text-sm sm:grid-cols-2"
        >
          {prev && (
            <a href={href(prev)} class="no-underline">
              <span class="text-muted block">← {t.previous}</span>
              {prev.data.title}
            </a>
          )}
          {next && (
            <a href={href(next)} class="no-underline sm:col-start-2 sm:text-right">
              <span class="text-muted block">{t.next} →</span>
              {next.data.title}
            </a>
          )}
        </nav>
      )}
    </article>
  </div>
</BaseLayout>
