---
import Logo from '../../assets/logo.svg';
import { features, nav, site } from '../../config';
import { useT } from '../../i18n/t';
import { Icon } from 'astro-icon/components';
import { localizeHref } from '../../utils/i18n';
import ThemeToggle from './ThemeToggle.astro';

const t = useT(Astro.currentLocale);

const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => {
  const h = href.replace(/\/$/, '');
  return path === h || path.startsWith(`${h}/`);
};
// pro-only. Links with a translated listing (/blog) point to the current language
const links = features.i18nRouting
  ? await Promise.all(
      nav.header.map(async (l) => ({
        ...l,
        href: await localizeHref(l.href, Astro.currentLocale),
      })),
    )
  : nav.header;
---

<header class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-6">
  <a href="/" class="text-foreground flex items-center gap-1.5 text-xl font-medium no-underline">
    <Logo class="text-primary size-7" aria-hidden="true" />
    {site.name}
  </a>
  <div class="flex items-center gap-2 sm:gap-4">
    <nav aria-label={t.mainNav}>
      <ul class="flex gap-4 font-sans text-sm sm:gap-6">
        {links.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrent(href) ? 'page' : undefined}
              class="text-muted hover:text-foreground aria-[current=page]:text-foreground no-underline transition-colors"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    {features.search && (
      <a
        href="/search/"
        aria-label={t.search}
        class="text-muted hover:text-foreground inline-flex size-10 items-center justify-center rounded-full no-underline transition-colors"
      >
        <Icon name="lucide:search" class="size-5" aria-hidden="true" />
      </a>
    )}
    {features.darkMode && <ThemeToggle />}
  </div>
</header>
