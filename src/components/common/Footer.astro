---
import { Icon } from 'astro-icon/components';
import { features, nav, site } from '../../config';
import { useT } from '../../i18n/t';
import LanguagePicker from './LanguagePicker.astro';
import { PHRASES, season } from '../../custom/utils/church-year'; // rab: place and season line

const t = useT(Astro.currentLocale);

const year = new Date().getFullYear();
---

<footer class="border-border mt-24 border-t">
  <div class="hang text-muted mx-auto max-w-5xl px-4 pt-10 pb-14 font-sans text-sm">
    <div>
      <p>
        © {year} {site.author}
      </p>
      {/* rab: place and the season of the church year on the day the site was built */}
      <p class="mt-1">{site.place}, {PHRASES[season()]}.</p>
      {/* rab: list and RSS icon shown only when there's something to show (features.footerRss) */}
      {(nav.social.length > 0 || features.footerRss) && (
      <ul class="mt-3 -ml-2.5 flex gap-1">
        {nav.social.map(({ label, href, icon }) => (
          <li>
            <a
              href={href}
              aria-label={label}
              rel="me noopener"
              class="text-muted hover:text-foreground inline-flex size-10 items-center justify-center"
            >
              <Icon name={icon} class="size-5" aria-hidden="true" />
            </a>
          </li>
        ))}
        {features.footerRss && (
        <li>
          <a
            href="/rss.xml"
            aria-label={t.rss}
            class="text-muted hover:text-foreground inline-flex size-10 items-center justify-center"
          >
            <Icon name="lucide:rss" class="size-5" aria-hidden="true" />
          </a>
        </li>
        )}
      </ul>
      )}
    </div>
    <nav aria-label={t.footerNav} class="flex flex-wrap gap-x-16 gap-y-8">
      {nav.footer.map((group) => (
        <div>
          <p class="section-label">{group.title}</p>
          <ul class="mt-2 space-y-1.5" aria-label={group.title}>
            {group.links.map(({ label, href }) => (
              <li>
                <a href={href} class="text-muted hover:text-foreground no-underline">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      {features.i18nRouting && <LanguagePicker />}
    </nav>
  </div>
</footer>
