---
// pro-only. Post contents. Shown only with 3+ h2/h3 headings. Collapsible, so it doesn't push the text down on mobile.
import type { MarkdownHeading } from 'astro';
import { useT } from '../../i18n/t';

const t = useT(Astro.currentLocale);

interface Props {
  headings: MarkdownHeading[];
}
// footnote-label is the footnote list heading (generated by the markdown processor)
const headings = Astro.props.headings.filter((h) => h.depth <= 3 && h.slug !== 'footnote-label');
---

{headings.length >= 3 && (
  <nav
    data-pagefind-ignore
    aria-label={t.toc}
    class="border-border mt-10 border-y py-4 font-sans text-sm"
  >
    <details open>
      <summary class="section-label cursor-pointer">{t.toc}</summary>
      <ol class="mt-4 space-y-2">
        {headings.map((h) => (
          <li class:list={[h.depth === 3 && 'pl-4']}>
            <a href={`#${h.slug}`} class="text-muted hover:text-primary no-underline">
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}
