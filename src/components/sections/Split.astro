---
// pro-only. Text and image side by side. reverse puts the image on the left.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';

interface Props {
  title: string;
  body: string;
  image: ImageMetadata;
  alt: string;
  action?: { label: string; href: string };
  reverse?: boolean;
}
const { title, body, image, alt, action, reverse = false } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 py-20">
  <div class="grid items-center gap-10 md:grid-cols-2">
    <div class:list={[reverse && 'md:order-last']}>
      <h2 class="text-4xl">{title}</h2>
      <p class="text-muted mt-4 text-lg">{body}</p>
      {action && (
        <Button href={action.href} variant="secondary" class="mt-8">
          {action.label}
        </Button>
      )}
    </div>
    <Image
      src={image}
      alt={alt}
      widths={[480, 960]}
      sizes="(min-width: 768px) 480px, 100vw"
      class="border-border h-auto w-full rounded-xs border"
    />
  </div>
</section>
