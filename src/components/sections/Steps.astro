---
// pro-only
interface Props {
  title: string;
  items: { title: string; body: string }[];
}
const { title, items } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 py-16">
  <h2 class="text-4xl">{title}</h2>
  <ol class="mt-10 max-w-prose space-y-8">
    {items.map((item, i) => (
      <li class="grid grid-cols-[3rem_1fr] gap-4">
        <span class="text-primary text-4xl leading-none font-light" aria-hidden="true">
          {i + 1}
        </span>
        <div>
          <h3 class="text-2xl font-medium">{item.title}</h3>
          <p class="text-muted mt-2">{item.body}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
