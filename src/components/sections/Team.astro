---
// pro-only. Shows the first letter of the name when there's no image.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  members: { name: string; role: string; bio?: string; image?: ImageMetadata }[];
}
const { title, members } = Astro.props;
---

<section class="hang mx-auto max-w-5xl px-4 py-14">
  <h2 class="section-label">{title}</h2>
  <ul class="grid gap-10 sm:grid-cols-2">
    {members.map((member) => (
      <li class="flex gap-4">
        {member.image ? (
          <Image
            src={member.image}
            alt=""
            width={64}
            height={64}
            class="size-16 shrink-0 rounded-full object-cover"
          />
        ) : (
          <span
            class="border-border text-primary flex size-16 shrink-0 items-center justify-center rounded-full border text-2xl italic"
            aria-hidden="true"
          >
            {member.name.charAt(0)}
          </span>
        )}
        <div>
          <h3 class="text-xl font-medium">{member.name}</h3>
          <p class="text-muted font-sans text-sm">{member.role}</p>
          {member.bio && <p class="text-muted mt-2">{member.bio}</p>}
        </div>
      </li>
    ))}
  </ul>
</section>
