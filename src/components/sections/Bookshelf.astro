---
// pro-only. Books read or recommended.
interface Props {
  title: string;
  items: { title: string; author: string; note?: string; href?: string }[];
}
const { title, items } = Astro.props;
---

<section class="hang mx-auto max-w-5xl px-4 py-14">
  <h2 class="section-label">{title}</h2>
  <ul class="grid gap-x-10 gap-y-6 md:grid-cols-2">
    {items.map((item) => (
      <li class="border-border border-b pb-6">
        <h3 class="text-xl font-medium italic">
          {item.href ? (
            <a href={item.href} class="text-foreground hover:text-primary no-underline">
              {item.title}
            </a>
          ) : (
            item.title
          )}
        </h3>
        <p class="text-muted font-sans text-sm">{item.author}</p>
        {item.note && <p class="mt-2">{item.note}</p>}
      </li>
    ))}
  </ul>
</section>
