---
// pro-only. Post titles grouped by year.
import { formatDate, postHref, type Post } from '../../utils/posts';

interface Props {
  title: string;
  posts: Post[];
}
const { title, posts } = Astro.props;
const years = Map.groupBy(posts, (post) => post.data.pubDate.getUTCFullYear());
---

<section class="mx-auto max-w-5xl px-4 py-12">
  <h2 class="text-4xl">{title}</h2>
  <div class="mt-8 space-y-10">
    {[...years].map(([year, items]) => (
      <div class="grid gap-4 md:grid-cols-[8rem_1fr]">
        <h3 class="text-primary text-3xl">{year}</h3>
        <ul class="divide-border divide-y">
          {items.map((post) => (
            <li class="flex flex-col justify-between gap-x-4 py-3 sm:flex-row sm:items-baseline">
              <a
                href={postHref(post)}
                class="text-foreground hover:text-primary text-lg no-underline"
              >
                {post.data.title}
              </a>
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-muted shrink-0 font-sans text-sm"
              >
                {formatDate(post.data.pubDate, Astro.currentLocale)}
              </time>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
