---
// pro-only
interface Props {
  quote: string;
  cite?: string;
}
const { quote, cite } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 py-20">
  <figure class="hang">
    <span class="text-primary text-6xl leading-none lg:text-right" aria-hidden="true">
      ¶
    </span>
    <div>
      <blockquote class="max-w-3xl text-3xl font-light italic sm:text-4xl">{quote}</blockquote>
      {cite && <figcaption class="text-muted mt-6 font-sans text-sm">{cite}</figcaption>}
    </div>
  </figure>
</section>
