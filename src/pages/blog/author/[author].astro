---
// pro-only. Posts by author.
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/blog/PostList.astro';
import { useT } from '../../../i18n/t';
import { getPosts } from '../../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts(null); // pro-only. Posts in every language
  return (await getCollection('authors')).map((author) => ({
    params: { author: author.id },
    props: { author, posts: posts.filter((p) => p.data.author?.id === author.id) },
  }));
}) satisfies GetStaticPaths;

const t = useT(Astro.currentLocale);

const { author, posts } = Astro.props;
const { name, bio, url } = author.data;
---

<BaseLayout
  title={t.postsBy.replace('{name}', name)}
  description={t.authorDescription.replace('{name}', name)}
>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
    <p class="text-muted font-sans text-sm">
      <a href="/blog/" class="underline">
        {t.allPosts}
      </a>{' '}
      / {t.writtenBy}
    </p>
    <h1 class="mt-3 text-5xl font-light tracking-tight">{name}</h1>
    <p class="text-muted mt-4 max-w-prose text-xl">{bio}</p>
    {url && (
      <p class="mt-4 font-sans text-sm">
        <a href={url}>{new URL(url).host}</a>
      </p>
    )}
    <div class="mt-12">
      <PostList posts={posts} />
    </div>
  </div>
</BaseLayout>
