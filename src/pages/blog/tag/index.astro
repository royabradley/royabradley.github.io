---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useT } from '../../../i18n/t';
import { getPosts, groupByTag } from '../../../utils/posts';

// Alphabetical tag index; each tag links to its page.
const t = useT(Astro.currentLocale);
const tags = [...groupByTag(await getPosts(null))].sort(([, a], [, b]) =>
  a.name.localeCompare(b.name),
);
---

<BaseLayout title={t.tags} description={t.tagsDescription}>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
    <p class="text-muted font-sans text-sm">
      <a href="/blog/" class="underline">
        {t.allPosts}
      </a>
    </p>
    <h1 class="mt-3 text-5xl font-light tracking-tight">{t.tags}</h1>
    <ul class="border-border mt-12 max-w-prose border-t">
      {tags.map(([slug, { name, posts }]) => (
        <li class="border-border border-b">
          <a
            href={`/blog/tag/${slug}/`}
            class="hover:text-primary flex items-baseline justify-between gap-4 py-3 no-underline"
          >
            <span class="text-xl">#{name}</span>
            <span class="text-muted font-sans text-sm tabular-nums">{posts.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
