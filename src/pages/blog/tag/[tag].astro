---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/blog/PostList.astro';
import { useT } from '../../../i18n/t';
import { getPosts, groupByTag } from '../../../utils/posts';

// Note: tag pages list everything without pagination. Switch to paginate() once a tag has dozens of posts.
export const getStaticPaths = (async () => {
  const posts = await getPosts(null); // pro-only. Posts in every language
  return [...groupByTag(posts)].map(([slug, props]) => ({ params: { tag: slug }, props }));
}) satisfies GetStaticPaths;

const t = useT(Astro.currentLocale);

const { name, posts } = Astro.props;
const title = `${t.taggedWith}: ${name}`;
---

<BaseLayout title={title} description={t.tagDescription.replace('{tag}', name)}>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
    <p class="text-muted font-sans text-sm">
      <a href="/blog/" class="underline">
        {t.allPosts}
      </a>{' '}
      /{' '}
      <a href="/blog/tag/" class="underline">
        {t.tags}
      </a>
    </p>
    <h1 class="mt-3 text-5xl font-light tracking-tight">#{name}</h1>
    <div class="mt-12">
      <PostList posts={posts} />
    </div>
  </div>
</BaseLayout>
