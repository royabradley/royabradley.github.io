---
// pro-only. Docs index.
import PageLayout from '../../layouts/PageLayout.astro';
import { docHref, getDocs } from '../../utils/docs';

const docs = await getDocs();
---

<PageLayout title="Documentation" description="How to set up, arrange, and write with Pilcrow.">
  <ol class="not-prose divide-border border-border divide-y border-y">
    {docs.map((doc) => (
      <li class="py-6">
        <h2 class="text-2xl font-medium">
          <a href={docHref(doc)} class="text-foreground hover:text-primary no-underline">
            {doc.data.title}
          </a>
        </h2>
        <p class="text-muted mt-1">{doc.data.description}</p>
      </li>
    ))}
  </ol>
</PageLayout>
