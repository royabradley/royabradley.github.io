---
// Home. Change section order and copy here. Section components live in src/components/sections/.
// A writer's home page: the newest essay large, then the ones before it. Theme marketing lives in /features.
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPost from '../components/sections/FeaturedPost.astro';
import Hero from '@custom/components/Hero.astro'; // rab: fork with an epigraph verse, see CUSTOMIZATIONS.md
import Newsletter from '../components/sections/Newsletter.astro';
import RecentPosts from '../components/sections/RecentPosts.astro';
import { useT } from '../i18n/t';
import { getPosts } from '../utils/posts';
import { newsletterForm } from '../utils/forms';

const t = useT(Astro.currentLocale);

const [latest, ...earlier] = await getPosts();
---

<BaseLayout>
  <Hero
    eyebrow="Reading slowly, thinking deeply, and attending to the sacramental life"
    verse={{
      lines: ['Earth’s crammed with heaven,', 'And every common bush afire with God:'],
      continuation: ['But only he who sees, takes off his shoes,', 'The rest sit round it, and pluck blackberries.'],
      author: 'Elizabeth Barrett Browning',
      work: 'Aurora Leigh',
    }}
  />
  {/* pro-only */}
  {latest && <FeaturedPost title="Latest" post={latest} />}
  <RecentPosts
    title="Earlier"
    posts={earlier.slice(0, 5)}
    moreLabel={t.allPosts}
    moreHref="/blog/"
  />
  {/* rab: Monthly Letter marked as in development until it launches */}
  <Newsletter
    title="The Monthly Letter"
    body="In development and coming soon: once a month, a new essay, three things worth reading, and a closing line. Signups open when the first letter is ready."
    {...newsletterForm()}
  />
</BaseLayout>
