{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/blog/typography-sampler/",
        "http://localhost/blog/on-rereading/",
        "http://localhost/blog/author/ada-marlow/",
        "http://localhost/sections/",
        "http://localhost/pricing/",
        "http://localhost/docs/configuration/",
        "http://localhost/work/the-margin-review-redesign/",
        "http://localhost/ko/blog/on-rereading/",
        "http://localhost/search/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
